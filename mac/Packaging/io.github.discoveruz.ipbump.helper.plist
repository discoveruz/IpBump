<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The root helper: applies network settings and sends ARP probes for everyone else (installed in /Library/LaunchDaemons) -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.github.discoveruz.ipbump.helper</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Library/PrivilegedHelperTools/io.github.discoveruz.ipbump.helper</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<!-- No AssociatedBundleIdentifiers: tied to the app, it would share the app's switch in Login Items, and
	     switching off "start at login" would stop the helper too -->
</dict>
</plist>
