<ui:FluentWindow x:Class="IpBump.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="IpBump"
                 Icon="pack://application:,,,/IpBump;component/Assets/IpBump.ico"
                 Width="480" Height="820" MinHeight="420"
                 ResizeMode="CanMinimize"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round"
                 Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
    <ui:FluentWindow.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,28,0,0" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,18,0,8" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Same layering as a Windows 11 dialog: lighter body, darker strip for the buttons -->
        <Border Grid.RowSpan="2" Background="{DynamicResource LayerFillColorAltBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" />

        <ui:TitleBar Title="IpBump" ShowMaximize="False" ShowMinimize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/IpBump;component/Assets/IpBump.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel x:Name="Form" Margin="24,4,24,24">
                <TextBlock Text="Edit IP settings" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />

                <ComboBox x:Name="Adapter" SelectionChanged="Adapter_SelectionChanged"
                          AutomationProperties.Name="Network adapter" />
                <TextBlock x:Name="AdapterStatus" Style="{StaticResource Hint}" Margin="0,6,0,0" />

                <TextBlock Text="IPv4" Style="{StaticResource Section}" Margin="0,22,0,0" />

                <TextBlock Text="IP address" Style="{StaticResource FieldLabel}" Margin="0,12,0,8" />
                <ui:TextBox x:Name="Ip" AutomationProperties.Name="IP address" TextChanged="Network_TextChanged" />

                <TextBlock Text="Subnet mask" Style="{StaticResource FieldLabel}" />
                <ui:TextBox x:Name="Mask" AutomationProperties.Name="Subnet mask" TextChanged="Network_TextChanged" />

                <TextBlock Text="Gateway" Style="{StaticResource FieldLabel}" />
                <ui:TextBox x:Name="Gateway" AutomationProperties.Name="Gateway" />

                <TextBlock Text="Preferred DNS" Style="{StaticResource FieldLabel}" />
                <ui:TextBox x:Name="Dns1" AutomationProperties.Name="Preferred DNS" />

                <TextBlock Text="Alternate DNS" Style="{StaticResource FieldLabel}" />
                <ui:TextBox x:Name="Dns2" AutomationProperties.Name="Alternate DNS" />

                <ui:HyperlinkButton Content="Use the adapter's current values" Click="ReadFromAdapter_Click"
                                    Margin="-10,10,0,0" Padding="10,6" />

                <TextBlock Text="Free address search" Style="{StaticResource Section}" Margin="0,20,0,0" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                           Text="Double-click the tray icon to move to an address nobody is using. Limit the search here, or leave both empty to use the whole network." />
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="From" FontSize="14" Margin="0,0,0,8" />
                        <ui:TextBox x:Name="RangeStart" AutomationProperties.Name="Search from" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="To" FontSize="14" Margin="0,0,0,8" />
                        <ui:TextBox x:Name="RangeEnd" AutomationProperties.Name="Search to" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="AI agents" Style="{StaticResource Section}" />
                <TextBlock Text="Let AI agents (Claude, Gemini) change the IP" Style="{StaticResource FieldLabel}" Margin="0,12,0,8" />
                <ui:ToggleSwitch x:Name="AllowAgents" OnContent="On" OffContent="Off"
                                 AutomationProperties.Name="Let AI agents change the IP" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,14,0,0"
                           Text="A connected agent changes the IP when you ask it to. Claude Code also does it by itself when its connection is refused." />
                <ItemsControl x:Name="Agents" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,14,0,0">
                                <ui:Button x:Name="Toggle" DockPanel.Dock="Right" Content="Connect" MinWidth="112"
                                           VerticalAlignment="Center" Click="Agent_Click"
                                           AutomationProperties.Name="{Binding Name, StringFormat='Connect {0}'}" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="14" />
                                    <TextBlock x:Name="State" Text="Not connected" Style="{StaticResource Hint}" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Connected}" Value="True">
                                    <Setter TargetName="Toggle" Property="Content" Value="Disconnect" />
                                    <Setter TargetName="Toggle" Property="AutomationProperties.Name"
                                            Value="{Binding Name, StringFormat='Disconnect {0}'}" />
                                    <Setter TargetName="State" Property="Text" Value="Connected" />
                                    <Setter TargetName="State" Property="Foreground"
                                            Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="AgentHint" Style="{StaticResource Hint}" Margin="0,12,0,0" Visibility="Collapsed" />

                <TextBlock Text="Taskbar" Style="{StaticResource Section}" />
                <TextBlock Text="Show the IP address on the taskbar" Style="{StaticResource FieldLabel}" Margin="0,12,0,8" />
                <ui:ToggleSwitch x:Name="OnTaskbar" OnContent="On" OffContent="Off"
                                 AutomationProperties.Name="Show the IP address on the taskbar" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,14,0,0"
                           Text="Written beside the clock and tray icons (Windows 11). Double-click it for a new address, right-click it for the menu." />

                <TextBlock Text="Notifications" Style="{StaticResource Section}" />
                <TextBlock Text="Show a notification after each change" Style="{StaticResource FieldLabel}" Margin="0,12,0,8" />
                <ui:ToggleSwitch x:Name="Notify" OnContent="On" OffContent="Off"
                                 AutomationProperties.Name="Show a notification after each change" />

                <TextBlock x:Name="About" Style="{StaticResource Hint}" Margin="0,28,0,0" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Margin="24">
            <!-- Plain elements rather than ui:InfoBar, whose text screen readers cannot see -->
            <Border x:Name="Error" Visibility="Collapsed" Margin="0,0,0,16" Padding="14,12" CornerRadius="4"
                    Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                <DockPanel>
                    <ui:SymbolIcon Symbol="ErrorCircle24" Filled="True" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Top"
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                    <TextBlock x:Name="ErrorText" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center"
                               AutomationProperties.LiveSetting="Assertive" />
                </DockPanel>
            </Border>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <ui:Button x:Name="SaveButton" Content="Save" Appearance="Primary" IsDefault="True"
                           HorizontalAlignment="Stretch" Click="Save_Click" />
                <ui:Button Grid.Column="2" Content="Cancel" IsCancel="True"
                           HorizontalAlignment="Stretch" Click="Cancel_Click" />
            </Grid>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
